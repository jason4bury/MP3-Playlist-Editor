# MP3 Playlist Editor settings. Copy this file to .env next to docker-compose.yml, fill in the
# values, then run:
#   docker compose up -d
# .env holds your real password: it is gitignored, so never commit it.

# --- Docker (used by docker-compose.yml) ---
# Port on the host: the app is at http://<your-server>:PORT
PORT=3002

# Image tag to run: latest, or a version such as 1.02
MP3_PLAYLIST_EDITOR_TAG=latest

# Optional: a host folder for playlists, attached MP3s and cover art, e.g.
#   DATA_HOST_DIR=D:/Docker/mp3-playlist-editor   or   /volume1/docker/mp3-playlist-editor
# Leave blank to use a named Docker volume (mp3-playlist-editor-data) instead.
DATA_HOST_DIR=

# --- Sign-in ---
# The app will not start until this is set to your own password (not changeme).
APP_PASSWORD=changeme

# true turns the login screen off completely. Only do this on a network you fully trust.
DISABLE_LOGIN=false

# true if the app sits behind a reverse proxy (Nginx Proxy Manager, Caddy, Traefik...), so the
# sign-in lockout counts wrong passwords per real client rather than per proxy.
TRUST_PROXY=false

# --- Running without Docker (npm start) ---
# Set DATA_DIR and APP_PASSWORD in your shell, e.g. DATA_DIR=./data. It listens on port 3000
# unless PORT is set. The Docker settings above are then ignored.
